# Copy to .env and fill in. Never commit .env.

# Required when DJANGO_DEBUG is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 1 for local development, 0 (or unset) in production.
DJANGO_DEBUG=0

# Comma-separated host names the app answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite file location. Docker Compose sets /data/db.sqlite3 (persistent volume) itself.
# DJANGO_SQLITE_PATH=db.sqlite3

# Host port of the app (default 8000).
# ZM_PORT=8000

# --- Backups by e-mail ---
# Where the „Zálohovat“ button sends the backup (comma-separated addresses).
BACKUP_EMAIL_TO=

# SMTP account the app sends from. Without EMAIL_HOST, e-mails are only printed to the log.
# Gmail: create an app password at https://myaccount.google.com/apppasswords
# (requires 2-step verification) and paste it as EMAIL_HOST_PASSWORD.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=zuzasmanager@gmail.com
EMAIL_HOST_PASSWORD=
