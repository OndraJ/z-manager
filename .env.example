# Copy to .env and fill in. Never commit .env.

# Required when DJANGO_DEBUG is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 1 for local development, 0 (or unset) in production.
DJANGO_DEBUG=0

# Comma-separated host names the app answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite file location. Docker Compose sets /data/db.sqlite3 (persistent volume) itself.
# DJANGO_SQLITE_PATH=db.sqlite3

# Host port of the app (default 8000).
# ZM_PORT=8000

# --- Backups by e-mail (sent from zuzasmanager@gmail.com, see README → Backups) ---
# Where the „Zálohovat“ button sends the backup (comma-separated addresses).
BACKUP_EMAIL_TO=

# App password of zuzasmanager@gmail.com (https://myaccount.google.com/apppasswords).
# Leave empty in development: backups are then only printed to the log.
EMAIL_HOST_PASSWORD=
